; Engine configuration file.
; Regenerated by Godot when the editor saves; edit it by hand only for things
; the editor cannot set, and read the diff when it rewrites.

config_version=5

[application]

config/name="Stillwater"
config/description="A fishing game that starts on a calm lake at dawn. Depth is not a distance."
run/main_scene="res://src/game/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

; The Android back button is handled by the game, never a silent quit. It unwinds
; one layer at a time - the book, a room, a menu, the title - and only quits from
; the seat with nothing open. See `_notification` in main.gd, which is where the
; behaviour lives; turning this off without handling GO_BACK makes the button DEAD,
; which is worse than the quit it replaced.
config/quit_on_go_back=false

[autoload]

; Records and replays touch input for filmed runs (scripts/movie.ps1). Inert without a user arg.
ReplayPlayer="*res://scripts/replay_player.gd"

[display]

; Portrait, because that is the only shape these games are played in.
window/size/viewport_width=1080
window/size/viewport_height=1920
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

; "mobile" is the Vulkan mobile backend - the right default for a modern
; Android phone. "gl_compatibility" is the fallback for old hardware and costs
; real visual features; do not switch to it without measuring first.
renderer/rendering_method="mobile"
; Dithers the final image. A near-black gradient - which is most of what this
; game looks like after Old Town - bands into visible contour rings on an 8-bit
; target, and because each channel steps at a different value they come out
; RAINBOW. It looked like an oil slick on the water and it is a display artefact,
; not a shader bug. Costs nothing measurable.
anti_aliasing/quality/use_debanding=true
; 2x MSAA. Everything in this game is a long thin edge seen almost end on - a
; gunwale, a plank, a reed, a rod - and the port rail was rendering as a dashed
; hairline of blown white pixels where the low sun caught its top face at a
; sliver of a pixel wide. MSAA is the one thing that fixes a geometric sliver,
; and on a tile-based mobile GPU it resolves inside tile memory: on hardware
; that already measures 5 ms a frame at the 95th percentile, 2x is affordable.
anti_aliasing/quality/msaa_3d=1
renderer/rendering_method.mobile="mobile"

; Required for an Android export - the exporter refuses without it. Mobile
; GPUs want ETC2/ASTC rather than the desktop S3TC/BPTC formats, and importing
; both is what lets one project ship to a phone and a desktop preview.
textures/vram_compression/import_etc2_astc=true

; ANISOTROPIC FILTERING, and it is not a nicety here.
;
; Almost everything in this game is a plank, a gunwale or a lake seen at a
; grazing angle, which is the exact case trilinear filtering handles worst: the
; footprint of one pixel on a tiling wood grain is a long thin smear, and a
; square mip sample of it either blurs across the grain or aliases along it.
; Sixteen taps is free on this hardware - the phone measures 5 ms a frame at the
; 50th, 90th AND 95th percentile - and it is the difference between planks and
; stipple.
textures/default_filters/anisotropic_filtering_level=3

[physics]

; Nothing here uses the physics server - collision is arithmetic in Sim, which
; is what lets the tests run with no scene tree. Left at defaults deliberately
; rather than tuned, so it is obvious it is unused.
common/physics_ticks_per_second=60
